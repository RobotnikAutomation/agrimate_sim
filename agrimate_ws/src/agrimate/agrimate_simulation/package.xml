<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agrimate_simulation</name>
  <version>0.1.0</version>
  <description>
    AgriMate Gazebo simulation package with worlds, models, and base launch
    files for the RB-Fiqus AgriMate robot.
  </description>
  <maintainer email="jlgalan@robotnik.es">jlgalan</maintainer>
  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>robotnik_description</depend>
  <depend>robotnik_gazebo_ignition</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
